{
  "number": 84,
  "name_arabic": "الإنشقاق",
  "name_transliteration": "Al-Inshiqaq",
  "name_meaning": "The Splitting Open",
  "revelation_type": "Meccan",
  "ayah_count": 25,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَـٰقِيهِ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "وَيَصْلَىٰ سَعِيرًا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 20,
      "text_uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 21,
      "text_uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": true
    },
    {
      "number": 22,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 23,
      "text_uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 24,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    },
    {
      "number": 25,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "juz": 30,
      "hizb": 59,
      "page": 589,
      "sajdah": false
    }
  ]
}