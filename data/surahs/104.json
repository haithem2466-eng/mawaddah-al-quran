{
  "number": 104,
  "name_arabic": "الهمزة",
  "name_transliteration": "Al-Humazah",
  "name_meaning": "The Traducer",
  "revelation_type": "Meccan",
  "ayah_count": 9,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",
      "juz": 30,
      "hizb": 60,
      "page": 601,
      "sajdah": false
    }
  ]
}