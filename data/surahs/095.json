    {
      "number": 2,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
      "juz": 30,
      "hizb": 60,
      "page": 597,
      "sajdah": false
    }
