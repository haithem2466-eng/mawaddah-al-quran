{
  "number": 99,
  "name_arabic": "الزلزلة",
  "name_transliteration": "Az-Zalzalah",
  "name_meaning": "The Earthquake",
  "revelation_type": "Medinan",
  "ayah_count": 8,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    }
  ]
}