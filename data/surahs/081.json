{
  "number": 81,
  "name_arabic": "التكوير",
  "name_transliteration": "At-Takwir",
  "name_meaning": "The Overthrowing",
  "revelation_type": "Meccan",
  "ayah_count": 29,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 20,
      "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 21,
      "text_uthmani": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 22,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 23,
      "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍۢ رَّجِيمٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 26,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 27,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَـٰلَمِينَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    },
    {
      "number": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "juz": 30,
      "hizb": 59,
      "page": 586,
      "sajdah": false
    }
  ]
}