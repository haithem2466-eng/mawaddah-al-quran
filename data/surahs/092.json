{
  "number": 92,
  "name_arabic": "الليل",
  "name_transliteration": "Al-Lail",
  "name_meaning": "The Night",
  "revelation_type": "Meccan",
  "ayah_count": 21,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 20,
      "text_uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 21,
      "text_uthmani": "وَلَسَوْفَ يَرْضَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    }
  ]
}