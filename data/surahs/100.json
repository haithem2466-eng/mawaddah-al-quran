  "ayah_count": 11,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَٱلْعَـٰدِيَـٰتِ ضَبْحًۭا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "فَٱلْمُورِيَـٰتِ قَدْحًۭا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًۭا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًۭا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "juz": 30,
      "hizb": 60,
      "page": 599,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "juz": 30,
      "hizb": 60,
      "page": 600,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ",
      "juz": 30,
      "hizb": 60,
      "page": 600,
      "sajdah": false
    }
  ]
}