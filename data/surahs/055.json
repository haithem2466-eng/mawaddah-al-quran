{
  "number": 55,
  "name_arabic": "الرحمن",
  "name_transliteration": "Ar-Rahman",
  "name_meaning": "The Beneficent",
  "revelation_type": "Medinan",
  "ayah_count": 78,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "ٱلرَّحْمَـٰنُ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "عَلَّمَ ٱلْقُرْءَانَ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "عَلَّمَهُ ٱلْبَيَانَ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "فِيهَا فَـٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍۢ كَٱلْفَخَّارِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 531,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 20,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 21,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 22,
      "text_uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 23,
