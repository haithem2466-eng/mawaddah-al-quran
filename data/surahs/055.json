      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 27,
      "text_uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 28,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 29,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 30,
