      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 24,
      "text_uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",
      "juz": 27,
      "hizb": 54,
      "page": 532,
      "sajdah": false
    },
    {
      "number": 25,
