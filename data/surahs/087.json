{
  "number": 87,
  "name_arabic": "الأعلى",
  "name_transliteration": "Al-Ala",
  "name_meaning": "The Most High",
  "revelation_type": "Meccan",
  "ayah_count": 19,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "juz": 30,
      "hizb": 60,
      "page": 592,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 592,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 592,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 592,
      "sajdah": false
    }
  ]
}