{
  "number": 91,
  "name_arabic": "الشمس",
  "name_transliteration": "Ash-Shams",
  "name_meaning": "The Sun",
  "revelation_type": "Meccan",
  "ayah_count": 15,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَٱلشَّمْسِ وَضُحَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "وَلَا يَخَافُ عُقْبَـٰهَا",
      "juz": 30,
      "hizb": 60,
      "page": 595,
      "sajdah": false
    }
  ]
}