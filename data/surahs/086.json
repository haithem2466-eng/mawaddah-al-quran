{
  "number": 86,
  "name_arabic": "الطارق",
  "name_transliteration": "At-Tariq",
  "name_meaning": "The Nightcomer",
  "revelation_type": "Meccan",
  "ayah_count": 17,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "وَمَا هُوَ بِٱلْهَزْلِ",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "وَأَكِيدُ كَيْدًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "juz": 30,
      "hizb": 59,
      "page": 591,
      "sajdah": false
    }
  ]
}