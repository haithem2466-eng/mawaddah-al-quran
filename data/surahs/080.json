{
  "number": 80,
  "name_arabic": "عبس",
  "name_transliteration": "Abasa",
  "name_meaning": "He Frowned",
  "revelation_type": "Meccan",
  "ayah_count": 42,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "عَبَسَ وَتَوَلَّىٰٓ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "وَهُوَ يَخْشَىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 12,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 13,
      "text_uthmani": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 14,
      "text_uthmani": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 15,
      "text_uthmani": "بِأَيْدِى سَفَرَةٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 16,
      "text_uthmani": "كِرَامٍۭ بَرَرَةٍۢ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 17,
      "text_uthmani": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 18,
      "text_uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 19,
      "text_uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 20,
      "text_uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 21,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 22,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 23,
      "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 24,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 25,
      "text_uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 26,
      "text_uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 27,
      "text_uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 28,
      "text_uthmani": "وَعِنَبًۭا وَقَضْبًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 29,
      "text_uthmani": "وَزَيْتُونًۭا وَنَخْلًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 30,
      "text_uthmani": "وَحَدَآئِقَ غُلْبًۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 31,
      "text_uthmani": "وَفَـٰكِهَةًۭ وَأَبًّۭا",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 32,
      "text_uthmani": "مَّتَـٰعًۭا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 33,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 34,
      "text_uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 35,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 36,
      "text_uthmani": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 37,
      "text_uthmani": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 38,
      "text_uthmani": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 39,
      "text_uthmani": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 40,
      "text_uthmani": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 41,
      "text_uthmani": "تَرْهَقُهَا قَتَرَةٌ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    },
    {
      "number": 42,
      "text_uthmani": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "juz": 30,
      "hizb": 59,
      "page": 585,
      "sajdah": false
    }
  ]
}