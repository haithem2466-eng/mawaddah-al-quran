  "ayah_count": 11,
  "ayahs": [
    {
      "number": 1,
      "text_uthmani": "وَٱلضُّحَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 2,
      "text_uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 3,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 4,
      "text_uthmani": "وَلَلْـَٔاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 5,
      "text_uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 6,
      "text_uthmani": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 7,
      "text_uthmani": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 8,
      "text_uthmani": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 9,
      "text_uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 10,
      "text_uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    },
    {
      "number": 11,
      "text_uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "juz": 30,
      "hizb": 60,
      "page": 596,
      "sajdah": false
    }
  ]
}